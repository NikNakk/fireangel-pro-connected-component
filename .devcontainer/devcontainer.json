{
  "name": "FireAngel Pro Connected",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "mounts": [
    "source=codex-home,target=/home/vscode/.codex,type=volume"
  ],
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.codex",
  "postCreateCommand": "mkdir -p .devcontainer/config/custom_components && ln -sfn ${containerWorkspaceFolder}/custom_components/fireangel_pro_connected .devcontainer/config/custom_components/fireangel_pro_connected",
  "containerEnv": {
    "ARDUINO_CONFIG_FILE": "/opt/arduino/arduino-cli.yaml",
    "PYTHONASYNCIODEBUG": "1"
  },
  "forwardPorts": [
    8123
  ],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
